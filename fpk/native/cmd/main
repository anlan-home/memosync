#!/bin/bash

# memosync 生命周期管理（加固版）
# 目录解析不依赖 fnOS 注入的环境变量：优先 TRIM_*，缺失时从脚本位置推导，
# 并把每次启动的解析结果写入日志——任何启动失败都能从 info.log 定位原因。

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APPDEST="${TRIM_APPDEST:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
PKGVAR="${TRIM_PKGVAR:-${APPDATADIR:-${APPDEST}/data}}"
LOG_DIR="${PKGVAR}/logs"
LOG_FILE="${LOG_DIR}/info.log"
PID_FILE="${PKGVAR}/app.pid"
BIN="${APPDEST}/bin/memosync"
CFG="${APPDEST}/conf/config.yaml"

mkdir -p "${LOG_DIR}" 2>/dev/null

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

ensure_config() {
    # 配置缺失时自动生成（安装脚本没跑、被清理等情况下自愈）
    if [ ! -f "${CFG}" ]; then
        mkdir -p "$(dirname "${CFG}")" 2>/dev/null
        PORT="${MEMOSYNC_PORT:-5231}"
        case "${PORT}" in
            ''|*[!0-9]*|0) PORT=5231 ;;
        esac
        {
            echo "listen: \":${PORT}\""
            echo "data_dir: \"${PKGVAR}\""
            echo "base_url: \"\""
            echo "log_file: \"${LOG_DIR}/memosync.log\""
        } > "${CFG}" 2>/dev/null
        log_msg "config.yaml 缺失，已自动生成 (port=${PORT}, data_dir=${PKGVAR})"
    fi
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    ensure_config

    if [ ! -x "${BIN}" ]; then
        log_msg "启动失败：${BIN} 不存在或不可执行（arch=$(uname -m)）。TRIM_APPDEST=${TRIM_APPDEST:-<unset>} PKGVAR=${PKGVAR}"
        echo "启动失败：${BIN} 不存在或不可执行" >&2
        return 1
    fi
    chmod +x "${BIN}" 2>/dev/null

    log_msg "Starting memosync ... (APPDEST=${APPDEST} PKGVAR=${PKGVAR} CFG=${CFG})"
    "${BIN}" -config "${CFG}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}" 2>/dev/null
    sleep 1
    if ! check_process "$(cat "${PID_FILE}" 2>/dev/null)"; then
        log_msg "启动后 1 秒进程已退出——详见日志中 memosync 自身的报错（通常是端口被占用或数据目录不可写）"
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}" 2>/dev/null
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
